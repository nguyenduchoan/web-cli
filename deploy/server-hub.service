[Unit]
Description=Server Hub with VietQR and Web CLI
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/mrhoan/apps/server-hub/current
EnvironmentFile=/home/mrhoan/.config/server-hub/web-cli.env
Environment=PATH=/home/mrhoan/.nvm/versions/node/v24.16.0/bin:/home/mrhoan/.local/bin:/home/mrhoan/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/mrhoan/.nvm/versions/node/v24.16.0/bin/node server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
LimitNOFILE=8192
TasksMax=256
MemoryMax=4G

[Install]
WantedBy=default.target
