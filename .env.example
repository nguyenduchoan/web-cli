# Web CLI now uses a local password + TOTP 2FA account.
# Keep the generated account under WEB_CLI_AUTH_DIR outside the repository.
WEB_CLI_AUTH_DIR=/var/lib/server-hub/web-cli-auth

# Backend bind.
# Use 127.0.0.1 for local-only.
# Keep loopback in production; access through the Server Hub HTTPS gateway.
HOST=127.0.0.1
PORT=3001

# Optional additional trusted frontend origins for local development.
CLIENT_ORIGIN=http://localhost:5173

# Comma-separated absolute project directories.
# Example:
# ALLOWED_PROJECT_DIRS=/home/user/projects/app1,/home/user/projects/app2
ALLOWED_PROJECT_DIRS=/home/user/projects/app1

# Optional. Override default agent config.
# AGENTS_CONFIG_JSON=[
#   {"id":"claude","label":"Claude Code","command":"claude","args":[],"quickActions":{"yesAll":"a\r","skip":"s\r","editFirst":"e\r"}},
#   {"id":"gemini","label":"Gemini CLI","command":"gemini","args":[],"quickActions":{"yesAll":"a\r","skip":"s\r","editFirst":"e\r"}},
#   {"id":"codex","label":"Codex CLI","command":"codex","args":[],"quickActions":{"yesAll":"a\r","skip":"s\r","editFirst":"e\r"}},
#   {"id":"opencode","label":"OpenCode CLI","command":"opencode","args":[],"quickActions":{"yesAll":"a\r","skip":"s\r","editFirst":"e\r"}}
# ]

OUTPUT_BUFFER_LIMIT=200000
WS_TICKET_TTL_MS=60000
LOG_TERMINAL_OUTPUT=false
LOG_LEVEL=info
MAX_SESSIONS=3
SESSION_IDLE_TTL_MS=14400000
SESSION_RETENTION_MS=3600000
SHUTDOWN_TIMEOUT_MS=15000
MAX_WS_CONNECTIONS=8
MAX_WS_BUFFERED_BYTES=1000000

# Chỉ các biến có tên trong danh sách này được truyền vào CLI agent.
# Không thêm AUTH_TOKEN, AGENTS_CONFIG_JSON hoặc ALLOWED_PROJECT_DIRS.
# Thêm credential riêng của agent nếu thực sự cần, ví dụ:
# AGENT_ENV_ALLOWLIST=PATH,HOME,USER,LOGNAME,SHELL,LANG,XDG_CONFIG_HOME,XDG_DATA_HOME,XDG_CACHE_HOME,ANTHROPIC_BASE_URL,ANTHROPIC_AUTH_TOKEN

# Frontend build/dev uses /api/web-cli/ and Vite's same-origin proxy by default.
